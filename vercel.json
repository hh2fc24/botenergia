{
    "version": 2,
    "builds": [
        {
            "src": "api/src/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/embed/(.*)",
            "dest": "/api/src/index.ts"
        },
        {
            "src": "/widget/(.*)",
            "dest": "/api/src/index.ts"
        },
        {
            "src": "/dashboard/(.*)",
            "dest": "/api/src/index.ts"
        },
        {
            "src": "/v1/(.*)",
            "dest": "/api/src/index.ts"
        },
        {
            "src": "/debug-paths",
            "dest": "/api/src/index.ts"
        },
        {
            "src": "/",
            "dest": "/api/src/index.ts"
        }
    ]
}